# 최소 수익률(%) - 이 이상일 때만 표시/알림
MIN_SPREAD_PERCENT=0.5

# USD/KRW 환율 (해외 USDT 가격을 원화로 환산할 때 사용)
# 기본값은 1300, 아래 값을 비워두면 기본값 사용
USD_KRW_RATE=1300
# 거래소 시세(예: 업비트 KRW-USDT)로 환율을 자동 갱신할지 여부
USD_KRW_AUTO=true
USD_KRW_REFRESH_SEC=30

# 모니터링 코인 (쉼표 구분, 비어두면 전체)
# MONITOR_SYMBOLS=BTC,ETH,USDT

# 알림
ALERT_SOUND_ENABLED=true

# 로그
LOG_LEVEL=INFO
